---
import Layout from "../layouts/Layout.astro";
import PostPreview from "../components/PostPreview.astro";
import { getCollection } from "astro:content";
import { Content as HomeContent } from "../content/home.mdx";
import { Content as ContactContent } from "../content/contact.mdx";

const postLimit = 3;
const allPosts = await getCollection("posts", ({ data }) => {
  return import.meta.env.DEV || data.published !== false;
});
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, postLimit);
---

<Layout title="ezioleq" ogTitle="Homepage">
  <div class="post-content">
    <HomeContent />

    <section class="recent-posts" style="margin-top: 2rem;">
      <h2 id="recent-posts" style="margin-bottom: 1.5rem;">
        <a
          class="heading-link"
          href="#recent-posts"
          title="Copy link to clipboard">Recent Posts</a
        >
      </h2>
      <div class="post-list">
        {recentPosts.map((post) => <PostPreview post={post} />)}
      </div>
      <div
        style="margin-top: 1rem; display: flex; justify-content: space-between; align-items: center;"
      >
        <a href="/index.xml" class="btn">Subscribe RSS</a>
        <p style="color: var(--text-muted)">
          Showing {postLimit} of {allPosts.length} posts
        </p>
        <a href="/posts" class="btn"> View All Posts &gt;</a>
      </div>
    </section>

    <ContactContent />
  </div>
</Layout>
