---
interface Props {
  prevUrl?: string;
  nextUrl?: string;
  currentPage: number;
  lastPage: number;
}

const { prevUrl, nextUrl, currentPage, lastPage } = Astro.props;
---

<nav
  class="pagination"
  style="display: flex; justify-content: space-between; align-items: center; margin-top: 1rem;"
>
  {
    prevUrl ? (
      <a href={prevUrl} class="btn">
        &lt Newer Posts
      </a>
    ) : (
      <a class="btn" href="/#recent-posts">
        &lt; Homepage
      </a>
    )
  }
  {
    (
      <p style="color: var(--text-muted);">
        Page {currentPage} of {lastPage}
      </p>
    )
  }
  {
    nextUrl ? (
      <a href={nextUrl} class="btn">
        Older Posts &gt;
      </a>
    ) : (
      <a href="/index.xml" class="btn">
        Subscribe RSS
      </a>
    )
  }
</nav>
