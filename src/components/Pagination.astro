---
interface Props {
  prevUrl?: string;
  nextUrl?: string;
}

const { prevUrl, nextUrl } = Astro.props;
---

<nav
  class="pagination"
  style="display: flex; justify-content: space-between; margin-top: 3rem;"
>
  {
    prevUrl ? (
      <a href={prevUrl} class="btn">
        &lt Newer Posts
      </a>
    ) : (
      <a class="btn" href="/#recent-posts">
        &lt; Homepage
      </a>
      // <span />
    )
  }
  {
    nextUrl ? (
      <a href={nextUrl} class="btn">
        Older Posts &gt;
      </a>
    ) : (
      <span />
    )
  }
</nav>
