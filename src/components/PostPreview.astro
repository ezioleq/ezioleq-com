---
interface Props {
  post: any;
}

const { post } = Astro.props;
---

<article class="post-preview" style="margin-bottom: 1.25rem;">
  <div
    style="display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 0.5rem; flex-wrap: nowrap;"
  >
    <h3
      style="margin: 0; flex: 1 1 auto; min-width: 0; word-break: break-word;"
    >
      <a href={`/posts/${post.id}`}>{post.data.title}</a>
    </h3>
    <time
      datetime={post.data.pubDate.toISOString()}
      style="color: var(--text-muted); font-size: 0.9em; flex-shrink: 0;"
    >
      {
        post.data.pubDate.toLocaleDateString("en-us", {
          year: "numeric",
          month: "short",
          day: "numeric",
        })
      }
    </time>
  </div>
  <p style="margin-top: 0.5rem; text-align: left;">
    {post.data.description}
  </p>
</article>
