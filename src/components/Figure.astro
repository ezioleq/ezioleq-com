---
interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="custom-figure">
  <a href={src} target="_blank" rel="noopener noreferrer">
    <img src={src} alt={alt} />
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  figure.custom-figure {
    margin: 1.5rem 0;
    padding: 0;
  }

  figure.custom-figure img {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
    display: block;
    /* border: 1px solid var(--border-color); */
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    text-align: center;
    font-style: italic;
  }
</style>
