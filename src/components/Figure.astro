---
import { Image } from 'astro:assets';

interface Props {
  // Local images: pass an imported ImageMetadata (import x from './x.webp')
  //   -> optimized (WebP, responsive srcset) via <Image>.
  // Remote images: pass a URL string -> rendered as-is, no build-time processing.
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
const isRemote = typeof src === 'string';
const href = isRemote ? src : src.src;
---

<figure class="custom-figure">
  <a class="figure-link" href={href} target="_blank" rel="noopener noreferrer">
    {isRemote ? (
      <img src={src} alt={alt} loading="lazy" decoding="async" />
    ) : (
      <Image src={src} alt={alt} />
    )}
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
