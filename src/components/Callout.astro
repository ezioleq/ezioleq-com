---
interface Props {
  type?: "info" | "warning" | "error";
  title?: string;
}

const { type = "info", title } = Astro.props;

// Map the CSS variables to internal variables for the component
const cssVarsMap = {
  info: "--callout-color: var(--callout-info-border); --callout-bg: var(--callout-info-bg);",
  warning:
    "--callout-color: var(--callout-warn-border); --callout-bg: var(--callout-warn-bg);",
  error: "--callout-color: #ff4a4a; --callout-bg: rgba(255, 74, 74, 0.1);",
};

const defaultTitles = {
  info: "Info",
  warning: "Warning",
  error: "Error",
};
---

<div class="callout" style={cssVarsMap[type]}>
  <div class="callout-title">
    <span class="callout-icon">
      {
        type === "info" && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <>
              <circle cx="12" cy="12" r="10" />
              <line x1="12" y1="16" x2="12" y2="12" />
              <line x1="12" y1="8" x2="12.01" y2="8" />
            </>
          </svg>
        )
      }
      {
        type === "warning" && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <>
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
              <line x1="12" y1="9" x2="12" y2="13" />
              <line x1="12" y1="17" x2="12.01" y2="17" />
            </>
          </svg>
        )
      }
      {
        type === "error" && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <>
              <circle cx="12" cy="12" r="10" />
              <line x1="15" y1="9" x2="9" y2="15" />
              <line x1="9" y1="9" x2="15" y2="15" />
            </>
          </svg>
        )
      }
    </span>
    <span class="callout-title-text">{title || defaultTitles[type]}</span>
  </div>
  <div class="callout-content">
    <slot />
  </div>
</div>

<style>
  .callout {
    margin: 1.5rem 0;
    padding: 0.8rem 1rem;
    background-color: var(--callout-bg);
    /* border-left: 4px solid var(--callout-color); */
    border-radius: 4px;
    background-blend-mode: overlay;
  }

  .callout-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 1rem;
    color: var(--callout-color);
    margin-bottom: 0.5rem;
  }

  .callout-icon {
    display: flex;
    align-items: center;
  }

  .callout-content {
    font-size: 0.95rem;
    color: var(--text-color);
    line-height: 1.5;
  }

  /* Ensure global markdown tags inside the callout maintain cozy padding */
  .callout-content :global(> *:first-child) {
    margin-top: 0;
  }
  .callout-content :global(> *:last-child) {
    margin-bottom: 0;
  }
</style>
